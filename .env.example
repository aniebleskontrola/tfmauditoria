PORT=4000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Secreto para firmar los tokens de sesión (HMAC SHA-256). Cámbialo en producción.
AUTH_SECRET=cambia-este-secreto-de-sesion

# --- Integración con sistemas externos (p. ej. Kontrola) ---
# API keys de los sistemas autorizados, en formato cliente:clave separadas por coma.
# Cada clave identifica al sistema que se conecta (se usa como "origen" en la bitácora).
AUDIT_API_KEYS=kontrola:cambia-esta-clave-por-una-segura
# Alternativa: clave dedicada para Kontrola (equivale a kontrola:<valor>).
KONTROLA_API_KEY=
# Webhook de salida: cada movimiento registrado se reenvía a esta URL en tiempo real.
KONTROLA_WEBHOOK_URL=
# Secreto opcional para firmar el webhook (HMAC SHA-256, encabezado X-Signature).
KONTROLA_WEBHOOK_SECRET=
